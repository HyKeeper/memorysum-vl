# memorysum-vl — example configuration
#
#   cp .env.example .env
#
# Every setting is a MEMORYSUM_* variable; the authoritative list (with defaults
# and validation) is src/memorysum_vl/core/config.py. `.env` is read from the
# current working directory, so start the service from the repository root.

# ── service ────────────────────────────────────────────────────────────────
MEMORYSUM_APP_NAME=memorysum-vl
MEMORYSUM_API_PREFIX=/v1
MEMORYSUM_TRACK=multimodal

# Auth: bearer token. Use one of the two forms below.
#   file  — one token per file, 0600, easier to rotate (recommended)
#   inline — MEMORYSUM_AUTH_TOKEN=... (handy in containers/secrets)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
MEMORYSUM_AUTH_TOKEN_FILE=.secrets/api_token
# MEMORYSUM_AUTH_TOKEN=change-me

# ── storage ────────────────────────────────────────────────────────────────
# One SQLite file holds raw text, image bytes, FTS5 indexes and sqlite-vec vectors.
MEMORYSUM_DB_PATH=data/memorysum.db
# Longest image side before sending to the models (Qwen3-VL patches at 32px;
# 1280 ≈ 1024 vision tokens). Lower = faster, higher = more detail.
MEMORYSUM_IMAGE_MAX_SIDE=1280

# ── embedding: Qwen3-VL-Embedding-2B ──────────────────────────────────────
# Text and images share one vector space (see docs/models.md).
MEMORYSUM_EMBEDDING_BASE_URL=http://127.0.0.1:7998
MEMORYSUM_EMBEDDING_MODEL=qwen3-vl-embedding-2b
# Baked into the sqlite-vec tables on first start; changing it needs a fresh DB.
MEMORYSUM_EMBEDDING_DIM=2048
MEMORYSUM_EMBEDDING_BATCH_SIZE=8
MEMORYSUM_EMBEDDING_CONCURRENCY=4
MEMORYSUM_EMBEDDING_TIMEOUT=30
MEMORYSUM_EMBEDDING_RETRIES=2
MEMORYSUM_EMBEDDING_INSTRUCTION=Represent the user's input.
MEMORYSUM_EMBEDDING_CHAT_TEMPLATE=true
# Must match LLAMA_MEDIA_MARKER on the server, otherwise multimodal requests
# fail with "number of media markers in text (0) does not match number of bitmaps".
MEMORYSUM_EMBEDDING_MEDIA_MARKER=<__media__>
MEMORYSUM_EMBEDDING_MAX_QUERY_CHARS=1200
MEMORYSUM_RERANK_MAX_QUERY_CHARS=6000

# ── captioning: Rax-4.5 ───────────────────────────────────────────────────
MEMORYSUM_CAPTION_BASE_URL=http://127.0.0.1:7996
MEMORYSUM_CAPTION_MODEL=rax-4.5
MEMORYSUM_CAPTION_CONCURRENCY=3
MEMORYSUM_CAPTION_MAX_TOKENS=320
MEMORYSUM_CAPTION_TIMEOUT=90
MEMORYSUM_CAPTION_RETRIES=1
# Cache captions by image sha256 (the same screenshot is described once).
MEMORYSUM_CAPTION_CACHE=true

# ── reranking: bge-reranker-v2-m3 ─────────────────────────────────────────
MEMORYSUM_RERANK_BASE_URL=http://127.0.0.1:7997
MEMORYSUM_RERANK_MODEL=bge-reranker-v2-m3
MEMORYSUM_RERANK_ENABLED=true
# The fused pool is max(RERANK_TOP_N, top_k): keep RERANK_TOP_N >= your top_k.
MEMORYSUM_RERANK_TOP_N=60
MEMORYSUM_RERANK_DOC_CHARS=1200
MEMORYSUM_RERANK_TIMEOUT=20
MEMORYSUM_RERANK_RETRIES=1

# ── fusion ────────────────────────────────────────────────────────────────
# Candidates per route before RRF; raise for longer documents.
MEMORYSUM_ROUTE_POOL=120
MEMORYSUM_RRF_K=20
# Adapt k to the number of candidates (helps when a route returns few hits).
MEMORYSUM_RRF_K_ADAPTIVE=true
# How strongly the reranker's order overrides the RRF consensus.
MEMORYSUM_FUSION_WEIGHT=2.0
# Per-route weight overrides, e.g. dense_text=1.2,lexical=0.8 (empty = all 1.0)
MEMORYSUM_ROUTE_WEIGHTS=
MEMORYSUM_MAX_QUERY_IMAGES=4

# ── abstention ────────────────────────────────────────────────────────────
# If none of the question's content words exist in the corpus, return data: [].
# Off by default: returning [] scored worse than returning plausible evidence in
# our evaluation — turn it on only if strict "no evidence, no answer" is wanted.
MEMORYSUM_ABSTAIN_ENABLED=false
MEMORYSUM_ABSTAIN_MIN_TERMS=2
MEMORYSUM_ABSTAIN_MASS_RATIO=0.7

# ── multiple choice ───────────────────────────────────────────────────────
# Treat each option as its own lexical query.
MEMORYSUM_OPTIONS_ENABLED=true
MEMORYSUM_OPTIONS_PER_OPTION=2
MEMORYSUM_MAX_OPTIONS=8

# ── response shaping ──────────────────────────────────────────────────────
# Returning original images is useful (text in pictures is not in the caption)
# but the payload becomes large: a 100-hit multimodal response can be tens of MiB.
MEMORYSUM_RETURN_IMAGES=true
MEMORYSUM_RESPONSE_IMAGE_MAX_SIDE=1600
MEMORYSUM_RESPONSE_IMAGE_QUALITY=92
MEMORYSUM_MAX_RETURNED_IMAGES=40
MEMORYSUM_RESPONSE_IMAGE_PASSTHROUGH_BYTES=4194304
MEMORYSUM_MAX_RESPONSE_IMAGE_BYTES=25165824
MEMORYSUM_CONTENT_INCLUDE_TIMESTAMP=true
MEMORYSUM_CONTENT_INCLUDE_ROLE=true
MEMORYSUM_CONTENT_SESSION_LABEL=true
# Adjacent messages from the same session carried along with each hit.
MEMORYSUM_NEIGHBOR_EXPAND=2
MEMORYSUM_NEIGHBOR_EXPAND_CHARS=1600
# Clamp the result set when even the top hit is barely relevant (0 = off).
MEMORYSUM_WEAK_EVIDENCE_LIMIT=0
MEMORYSUM_WEAK_EVIDENCE_THRESHOLD=0.05

# ── logging ───────────────────────────────────────────────────────────────
# One line per event, size-rotated, never journald. Empty LOG_FILE = stderr.
MEMORYSUM_LOG_LEVEL=INFO
MEMORYSUM_LOG_FORMAT=text
MEMORYSUM_LOG_FILE=info.log
MEMORYSUM_LOG_MAX_BYTES=10485760
MEMORYSUM_LOG_BACKUP_COUNT=5
# Body limits in characters; 0 means UNLIMITED (which is not what you want in
# production: one 100-hit multimodal response can be tens of MiB).
MEMORYSUM_LOG_REQUEST_BODY_LIMIT=4096
MEMORYSUM_LOG_RESPONSE_BODY_LIMIT=2048
# Successful requests on these paths are logged at DEBUG; empty = log everything.
# Note: this drops the status/latency line too, so prefer the body limits above.
MEMORYSUM_LOG_QUIET_PATHS=
